{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Production: the static export in ./out behind src/worker.ts (ADR-0001). Deployed by GitHub Actions on
  // push to main. Previews use wrangler.preview.jsonc (another worker, workers.dev only).
  "name": "mokeet-elsuarye",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-10",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // The worker redirects old URLs and the bare domain, and adds security headers: it must see requests first.
    "run_worker_first": true
  },
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "www.mokeet-elsuarye.com", "custom_domain": true },
    { "pattern": "mokeet-elsuarye.com", "custom_domain": true }
  ],
  "workers_dev": false
}
