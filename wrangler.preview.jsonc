{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Preview of the redesign (spec 002): a separate worker on workers.dev, never on the live domain.
  // Build without SITE_LIVE so every page is noindex and no tags load, then:
  //   npx wrangler deploy -c wrangler.preview.jsonc
  "name": "mokeet-elsuarye-preview",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-10",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "workers_dev": true
}
